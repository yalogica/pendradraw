{
  "name": "pendradraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:excalidraw && pnpm --filter @pendradraw/tauri dev",
    "dev:web": "pnpm build:excalidraw && pnpm --filter @pendradraw/app dev",
    "build": "pnpm build:excalidraw && pnpm --filter @pendradraw/tauri build",
    "build:app": "pnpm --filter @pendradraw/app build",
    "build:excalidraw": "pnpm --filter @excalidraw/excalidraw build",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "rollup-plugin-license": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
