{
  "name": "@excalidraw/excalidraw",
  "version": "0.18.0",
  "description": "Excalidraw as a React component",
  "author": "Excalidraw",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/types/src/excalidraw/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/excalidraw/index.d.ts",
      "default": "./dist/index.es.js"
    },
    "./index.css": "./dist/index.css",
    "./types": "./dist/types/src/excalidraw/types.d.ts",
    "./common/*": {
      "types": "./dist/types/src/common/*.d.ts"
    },
    "./element/*": {
      "types": "./dist/types/src/element/*.d.ts"
    },
    "./math/*": {
      "types": "./dist/types/src/math/*.d.ts"
    },
    "./utils/*": {
      "types": "./dist/types/src/utils/*.d.ts"
    },
    "./fractional-indexing/*": {
      "types": "./dist/types/src/fractional-indexing/*.d.ts"
    },
    "./*": {
      "types": "./dist/types/src/excalidraw/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:git": "vite build --mode git"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.2.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@excalidraw/laser-pointer": "1.3.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@excalidraw/random-username": "1.1.0",
    "@lezer/highlight": "^1.0.0",
    "@uiw/react-color-colorful": "^2.10.4",
    "browser-fs-access": "0.38.0",
    "canvas-roundrect-polyfill": "0.0.1",
    "clsx": "1.1.1",
    "es6-promise-pool": "2.5.0",
    "fuzzy": "0.1.3",
    "image-blob-reduce": "3.0.1",
    "jotai": "2.11.0",
    "jotai-scope": "0.7.2",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "pako": "2.0.3",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "pwacompat": "2.0.17",
    "radix-ui": "1.4.3",
    "roughjs": "4.6.4",
    "tinycolor2": "1.6.0",
    "tunnel-rat": "0.1.2"
  },
  "devDependencies": {
    "@types/lodash.debounce": "4.0.8",
    "@types/lodash.throttle": "4.1.7",
    "@types/pako": "2.0.3",
    "@types/pica": "5.1.3",
    "@types/resize-observer-browser": "0.1.7",
    "@types/tinycolor2": "1.4.6",
    "sass-embedded": "^1.97.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/excalidraw/excalidraw"
  },
  "bugs": {
    "url": "https://github.com/excalidraw/excalidraw/issues"
  },
  "homepage": "https://github.com/excalidraw/excalidraw"
}